{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "torosu",
  "version": "1.0.0",
  "identifier": "com.manolo.torosu",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/torosu/browser"
  },
  "app": {
    "windows": [
      {
        "title": "torosu",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Manolo-dl",
    "homepage": "https://github.com/Manolo-dl/Torosu",
    "copyright": "Copyright (c) 2026 Manolo-dl",
    "category": "Utility",
    "shortDescription": "osu! stable tools in one app",
    "longDescription": "Torosu puts the tools you would need for osu! stable in one place: a beatmap downloader, collection import and export, beatmap packs and a trainer that changes the rate, the stats, the long notes or the key count of the map selected in osu!.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "licenses/osu-memory-reader/": "licenses/osu-memory-reader/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OTU0RjVGM0U2OTY0QzQKUldURVpHaytYMCtWMWpOa0R6c3RnT0NINThQN0crb3BiMkVJZU5RL0xRZHRYWnpQQmV0VmptdjUK",
      "endpoints": [
        "https://github.com/Manolo-dl/Torosu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
